# Run from this checkout after activating your Python environment.
# Data/result root (separate from the code checkout):
# export XENIUM_ROOT=/absolute/path/to/Xenium
# export XENIUM_ANNOTATION_ROOT="$XENIUM_ROOT/final_cell_annotations"
# export XENIUM_EPITHELIAL_ANNOTATION_ROOT=/absolute/path/to/epithelial_annotations
# export STPATH_TCGA_TIFF_ROOT=/absolute/path/to/TCGA_BRCA_HE_filtered_tiff
# Optional code location for Slurm submissions:
# export STPATH_CODE_ROOT=/absolute/path/to/STpath-BC
# Optional Slurm settings (omit when the cluster supplies defaults):
# export STPATH_SLURM_ACCOUNT=your_account
# export STPATH_SLURM_PARTITION=your_partition
# export STPATH_PYTHON=/absolute/path/to/environment/bin/python
# Optional current cross-platform comparisons against external frozen models:
# export STPATH_BRCA_VISIUM_RESULTS=/absolute/path/to/Visium/BRCA
# export STPATH_COAD_VISIUM_RESULTS=/absolute/path/to/Visium/COAD
